# ===== 复制为 .env 后填写；不要提交 .env =====

# --- 聊天模型（OpenAI 兼容）---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen3-8B

# --- 向量模型 ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=16

# --- 运行形态 / 数据库 ---
# embedded: 单进程内嵌图 + 开源 checkpointer（推荐，无需许可证，重启不丢历史）
# server:   调用独立 LangGraph 服务（需要 LangGraph Cloud 许可证）
APP_MODE=embedded
# 本地 SQLite（默认）；云端改成 postgresql://...
DATABASE_URL=sqlite:///./data/app.db
PORT=5000

# --- HTTP ---
HTTP_TIMEOUT=180
HTTP_MAX_RETRIES=3

# --- 日志 ---
LOG_LEVEL=INFO

# --- Flask ---
# 生成方式：python -c "import secrets;print(secrets.token_hex(16))"
FLASK_SECRET_KEY=replace-with-random-hex
ADMIN_PASSWORD=replace-with-strong-password
FLASK_DEBUG=False

# --- LangGraph 服务 ---
LANGGRAPH_API_URL=http://127.0.0.1:2024
LANGGRAPH_GRAPH_NAME=customer_service

# Docker Compose 里 agent 容器使用（本地 compose 会自动注入）
# POSTGRES_URI=postgres://globalshop:globalshop_local_only@db:5432/globalshop

# --- 云端（Render/Railway）---
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# LANGGRAPH_API_URL=http://<your-agent-service>:2024
